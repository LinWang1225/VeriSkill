# ---- Secrets (never commit) ----
env.sh
.claude/settings.json

# ---- Python ----
__pycache__/
*.pyc

# ---- Runtime pool (audited/rolled each round; setup regenerates from source pkl) ----
pool/traj/*
!pool/traj/.gitkeep
pool/checkers/*
!pool/checkers/.gitkeep
# 框架代码（非每轮生成）：SciBench-stat 确定性判分核心
!pool/checkers/checker_core_stat.py
pool/meta.json
pool/gate_allowlist.txt
# Runtime result artifacts are version-controlled (rounds/, history/,
# stats/, oracle_failures/, workspace/{actor_skills,critics}, ledger.json,
# report.md) so run outputs are tracked in-repo.

# ---- Logs ----
*.log

# ---- Claude Code ephemeral ----
.claude/plans/
