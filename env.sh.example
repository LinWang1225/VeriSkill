# cp env.sh.example env.sh 后填入真实值。env.sh 已在 .gitignore 里，不要提交。
export ANTHROPIC_BASE_URL='<YOUR_BASE_URL>'
export ANTHROPIC_AUTH_TOKEN='<YOUR_TOKEN>'
export ANTHROPIC_API_KEY='<YOUR_TOKEN>'
export IS_SANDBOX=1

export VERISKILL_BACKEND=claude
export VERISKILL_MODEL=glm-5.2

# 判决阈值。adjusted_score 低于它翻成 fail。
export VERISKILL_RUBRIC_THRESHOLD=0.75
# 存疑扣分权重：soft 判据命中 / concerns 条数 / (1 − 自报信心)
export VERISKILL_W_SOFT=0.25
export VERISKILL_W_CONCERN=0.10
export VERISKILL_W_CONF=1.0

export VERISKILL_JOBS=4
export VERISKILL_TIMEOUT=1800

# 附加做题说明，逐字进 solve 提示词。留空即不追加。
export VERISKILL_SOLVE_NOTE=''

export TMPDIR="$PWD/tmp"
export CLAUDE_CONFIG_DIR="$PWD/../claude_home"
